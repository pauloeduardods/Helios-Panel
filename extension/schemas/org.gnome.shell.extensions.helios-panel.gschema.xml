<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.helios-panel" path="/org/gnome/shell/extensions/helios-panel/">

    <!-- What the top bar shows -->
    <key name="show-cpu" type="b"><default>true</default><summary>Show CPU temperature</summary></key>
    <key name="show-gpu" type="b"><default>true</default><summary>Show GPU temperature</summary></key>
    <key name="show-fans" type="b"><default>false</default><summary>Show fan speed</summary></key>
    <key name="show-power" type="b"><default>false</default><summary>Show power draw on battery</summary></key>
    <key name="show-profile" type="b"><default>true</default><summary>Show power profile</summary></key>
    <key name="show-icons" type="b"><default>true</default><summary>Show icons</summary></key>
    <key name="show-unit" type="b"><default>false</default><summary>Show "°C" instead of "°"</summary></key>
    <key name="hide-gpu-when-off" type="b"><default>false</default><summary>Hide the GPU when it is off</summary></key>

    <key name="profile-names" type="s">
      <choices><choice value="predator"/><choice value="portuguese"/><choice value="linux"/></choices>
      <default>'predator'</default>
      <summary>Profile names</summary>
    </key>
    <key name="color-profile" type="b"><default>true</default><summary>Color the profile by power level</summary></key>

    <!-- Placement -->
    <key name="panel-position" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Position in the top bar</summary>
    </key>
    <key name="panel-index" type="i"><range min="0" max="20"/><default>0</default><summary>Order within the area</summary></key>

    <!-- Thresholds (°C) -->
    <key name="cpu-warm" type="i"><range min="30" max="110"/><default>80</default><summary>CPU: warm from</summary></key>
    <key name="cpu-hot" type="i"><range min="30" max="110"/><default>92</default><summary>CPU: hot from</summary></key>
    <key name="gpu-warm" type="i"><range min="30" max="110"/><default>75</default><summary>GPU: warm from</summary></key>
    <key name="gpu-hot" type="i"><range min="30" max="110"/><default>85</default><summary>GPU: hot from</summary></key>

    <!-- Colours (any CSS colour; empty = theme colour) -->
    <key name="color-normal" type="s"><default>''</default><summary>Normal color</summary></key>
    <key name="color-warm" type="s"><default>'#f8e45c'</default><summary>Warm color</summary></key>
    <key name="color-hot" type="s"><default>'#f66151'</default><summary>Hot color</summary></key>
    <key name="bold-when-hot" type="b"><default>true</default><summary>Bold when hot</summary></key>

    <!-- Sensors -->
    <key name="cpu-sensor" type="s"><default>''</default><summary>CPU sensor ('' = automatic)</summary></key>
    <key name="gpu-sensor" type="s"><default>''</default><summary>GPU sensor ('' = automatic, or hwmon:chip/label)</summary></key>
  </schema>
</schemalist>
