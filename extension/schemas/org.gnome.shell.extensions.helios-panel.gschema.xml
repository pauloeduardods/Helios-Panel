<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.helios-panel" path="/org/gnome/shell/extensions/helios-panel/">

    <!-- What the top bar showed before panel-layout. The show-* keys of the
         readings, show-icons, show-unit, panel-order and graph-* are only
         read once, to migrate them into panel-layout. hide-gpu-when-off,
         profile-names and color-profile are still used. -->
    <key name="show-cpu" type="b"><default>true</default><summary>Show CPU temperature</summary></key>
    <key name="show-gpu" type="b"><default>true</default><summary>Show GPU temperature</summary></key>
    <key name="show-fans" type="b"><default>false</default><summary>Show fan speed</summary></key>
    <key name="show-power" type="b"><default>false</default><summary>Show power draw on battery</summary></key>
    <key name="show-profile" type="b"><default>true</default><summary>Show power profile</summary></key>
    <key name="show-icons" type="b"><default>true</default><summary>Show icons</summary></key>
    <key name="show-unit" type="b"><default>false</default><summary>Show "°C" instead of "°"</summary></key>
    <key name="show-cpu-usage" type="b"><default>false</default><summary>Show CPU usage</summary></key>
    <key name="show-gpu-usage" type="b"><default>false</default><summary>Show GPU usage</summary></key>
    <key name="hide-gpu-when-off" type="b"><default>false</default><summary>Hide the GPU when it is off</summary></key>

    <key name="profile-names" type="s">
      <choices><choice value="predator"/><choice value="portuguese"/><choice value="linux"/></choices>
      <default>'predator'</default>
      <summary>Profile names</summary>
    </key>
    <key name="color-profile" type="b"><default>true</default><summary>Color the profile by power level</summary></key>

    <!-- Order of the top-bar items (ids from PANEL_ITEMS in lib/model.js) -->
    <key name="panel-order" type="as">
      <default>['cpu', 'gpu', 'cpu-usage', 'gpu-usage', 'fan', 'power', 'profile']</default>
      <summary>Order of the items in the top bar</summary>
    </key>

    <!-- Graphs in the top bar -->
    <key name="graph-items" type="as"><default>[]</default><summary>Items that show a graph in the top bar</summary></key>
    <key name="graph-only" type="as"><default>[]</default><summary>Items that show only their graph, without the number</summary></key>
    <key name="graph-window" type="i"><range min="60" max="300"/><default>120</default><summary>Seconds a top-bar graph spans</summary></key>
    <key name="graph-width" type="s">
      <choices><choice value="narrow"/><choice value="medium"/><choice value="wide"/></choices>
      <default>'medium'</default>
      <summary>Width of a top-bar graph</summary>
    </key>
    <key name="graph-style" type="s">
      <choices><choice value="line"/><choice value="area"/></choices>
      <default>'line'</default>
      <summary>Line or filled area</summary>
    </key>
    <key name="graph-color-mode" type="s">
      <choices><choice value="follow"/><choice value="fixed"/></choices>
      <default>'follow'</default>
      <summary>Graph color: follow the temperature colors, or one fixed color</summary>
    </key>
    <key name="graph-color" type="s"><default>'#62a0ea'</default><summary>Fixed graph color</summary></key>

    <!-- The top-bar layout: segments, templates and graphs, as JSON (see
         lib/layout.js and docs/ARCHITECTURE.md). Empty until the first run,
         which fills it once from the show-*, show-icons, show-unit,
         panel-order and graph-* keys above; those are not read after that. -->
    <key name="panel-layout" type="s">
      <default>''</default>
      <summary>Top-bar layout (JSON)</summary>
      <description>Segments the top bar shows, each with its readings, template, icon and graph. Empty means: build it once from the older settings.</description>
    </key>

    <!-- Placement -->
    <key name="panel-position" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Position in the top bar</summary>
    </key>
    <key name="panel-index" type="i"><range min="0" max="20"/><default>0</default><summary>Order within the area</summary></key>

    <!-- Thresholds (°C) -->
    <key name="cpu-warm" type="i"><range min="30" max="110"/><default>80</default><summary>CPU: warm from</summary></key>
    <key name="cpu-hot" type="i"><range min="30" max="110"/><default>92</default><summary>CPU: hot from</summary></key>
    <key name="gpu-warm" type="i"><range min="30" max="110"/><default>75</default><summary>GPU: warm from</summary></key>
    <key name="gpu-hot" type="i"><range min="30" max="110"/><default>85</default><summary>GPU: hot from</summary></key>

    <!-- Colours (any CSS colour; empty = theme colour) -->
    <key name="color-normal" type="s"><default>''</default><summary>Normal color</summary></key>
    <key name="color-warm" type="s"><default>'#f8e45c'</default><summary>Warm color</summary></key>
    <key name="color-hot" type="s"><default>'#f66151'</default><summary>Hot color</summary></key>
    <key name="bold-when-hot" type="b"><default>true</default><summary>Bold when hot</summary></key>

    <!-- Sensors -->
    <key name="cpu-sensor" type="s"><default>''</default><summary>CPU sensor ('' = automatic)</summary></key>
    <key name="gpu-sensor" type="s"><default>''</default><summary>GPU sensor ('' = automatic, or hwmon:chip/label)</summary></key>

    <!-- Alerts -->
    <key name="heat-alert" type="b"><default>true</default><summary>Notify when the CPU or GPU stays hot</summary></key>
    <key name="heat-alert-celsius" type="i"><range min="50" max="110"/><default>95</default><summary>Heat alert: from this temperature (°C)</summary></key>
    <key name="heat-alert-seconds" type="i"><range min="2" max="600"/><default>30</default><summary>Heat alert: after this many seconds</summary></key>
    <key name="battery-hint" type="b"><default>true</default><summary>Suggest a quieter profile when the battery runs low</summary></key>
    <key name="battery-hint-percent" type="i"><range min="5" max="80"/><default>20</default><summary>Battery hint: at or below this percent</summary></key>
    <key name="profile-on-battery" type="b"><default>false</default><summary>Switch the profile when unplugged and restore it when plugged in</summary></key>
    <key name="battery-profile" type="s"><default>''</default><summary>Profile on battery ('' = automatic: low-power, else quiet)</summary></key>
  </schema>
</schemalist>
