# OPTIONAL - Helios Panel
# Lets the "sudo" group (the administrators on Ubuntu) change the power
# profile by writing straight to the kernel file, without a password. The
# extension menu then shows every firmware profile (Eco, Quiet, Balanced,
# Performance, Turbo) instead of the 3 from power-profiles-daemon.
#
# Risk: any program running as a user in the sudo group can change the
# profile. The profiles are validated by the Acer firmware (the same ones as
# the mode key), so the worst case is the laptop going to Turbo and getting loud.
#
# Install:
#   sudo cp 99-helios-platform-profile.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo modprobe -r acer_wmi && sudo modprobe acer_wmi   (or reboot)
# Check (should show "-rw-rw-r-- root sudo"):
#   ls -l /sys/class/platform-profile/*/profile

ACTION=="add", SUBSYSTEM=="platform-profile", RUN+="/usr/bin/chgrp sudo /sys%p/profile", RUN+="/usr/bin/chmod g+w /sys%p/profile"
