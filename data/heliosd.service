[Unit]
Description=Helios laptop sensors, platform profile and lighting daemon
Documentation=https://github.com/pauloeduardods/Helios-Panel

[Service]
Type=dbus
BusName=io.github.pauloeduardods.Helios1
ExecStart=/usr/local/libexec/heliosd
Restart=on-failure

# Root only because the platform profile and lighting files are root-owned.
# No capabilities: file ownership alone allows those writes.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Everything read-only ...
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all
# ... except the platform profile (legacy file and the acer-wmi class device),
# the two files of the helios-acer-lighting module, when it is loaded, and
# the saved lighting state.
ReadWritePaths=-/sys/firmware/acpi/platform_profile
ReadWritePaths=-/sys/devices/platform/acer-wmi/platform-profile
ReadWritePaths=-/sys/bus/wmi/devices/7A4DDFE7-5B5D-40B4-8595-4408E0CC7F56/keyboard_effect
ReadWritePaths=-/sys/bus/wmi/devices/7A4DDFE7-5B5D-40B4-8595-4408E0CC7F56/logo
StateDirectory=heliosd
StateDirectoryMode=0700

# Devices: only what nvidia-smi needs to read a temperature (already 0666).
DevicePolicy=closed
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw

PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked call fails with EPERM instead of killing the process: nvidia-smi
# run as root tries chown() once and handles the error, but SIGSYS would
# crash it (and pop up Ubuntu's crash reporter).
SystemCallErrorNumber=EPERM
UMask=0077
